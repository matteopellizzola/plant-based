# Copia in hub/.env e modifica i valori.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=plants

# Token ottenuto da @BotFather. Il servizio non parte se resta vuoto.
TELEGRAM_BOT_TOKEN=
# ID numerici separati da virgola. Recuperali con /whoami nel bot.
# L'accesso resta chiuso finché non inserisci almeno un ID.
TELEGRAM_ALLOWED_USER_IDS=

# Database locale sul Raspberry.
DATABASE_PATH=hub/data/plant_hub.sqlite3


