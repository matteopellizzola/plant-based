[Unit]
Description=Plant Based Raspberry hub
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/plantBased/hub
ExecStart=/home/pi/plantBased/.venv/bin/python /home/pi/plantBased/hub/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
